<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_picking_form_inherit_purchase_prices" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.purchase.prices</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>

            <field name="arch" type="xml">

                <!-- Campos monetarios en líneas de recepción -->
                <xpath expr="//field[@name='move_ids']/tree/field[@name='product_uom']"
                       position="after">

                    <field name="purchase_price_unit"
                           readonly="1"
                           widget="monetary"
                           optional="show"/>

                    <field name="purchase_subtotal"
                           readonly="1"
                           widget="monetary"
                           optional="show"/>

                </xpath>

                <!-- Total aproximado de la recepción -->
                <xpath expr="//sheet" position="inside">

                    <group name="purchase_financial_total"
                           class="oe_subtotal_footer oe_right">

                        <field name="purchase_total"
                               readonly="1"
                               widget="monetary"
                               string="Total Recibido (Aprox)"/>

                    </group>

                    <div class="clearfix"/>

                </xpath>

            </field>

        </record>

    </data>
</odoo>
